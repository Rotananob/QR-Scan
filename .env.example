# Firebase Client Configuration (Public / Vite)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=rotana-nobb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rotana-nobb
VITE_FIREBASE_STORAGE_BUCKET=rotana-nobb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK (Vercel Serverless Functions)
# Provide the complete JSON service account string in production Vercel Environment Variables:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"rotana-nobb",...}
